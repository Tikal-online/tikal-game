{
  "name": "tikal-components",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "ng build tikal-ui-components",
    "format": "prettier --write \"./**/*.*\"",
    "format-verify": "prettier --check \"./**/*.*\"",
    "lint": "ng lint --fix",
    "lint-verify": "ng lint",
    "test": "vitest --config=projects/tikal-ui-components/vitest.config.ts --project=storybook",
    "test-ci": "vitest run --config=projects/tikal-ui-components/vitest.config.ts --project=storybook",
    "storybook": "ng run tikal-ui-components:storybook",
    "build-storybook": "ng run tikal-ui-components:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@primeicons/angular": "^8.0.0",
    "@primeuix/themes": "^3.0.0",
    "primeng": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "latest",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@compodoc/compodoc": "latest",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/angular-vite": "^10.5.10",
    "@types/node": "^20",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "angular-eslint": "^22.1.0",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.5",
    "eslint-plugin-storybook": "^10.5.10",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.67.0",
    "vitest": "latest"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true
  }
}
