{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "tikal-ui-components": {
      "projectType": "library",
      "root": "projects/tikal-ui-components",
      "sourceRoot": "projects/tikal-ui-components/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/tikal-ui-components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/tikal-ui-components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/tikal-ui-components/tsconfig.spec.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "projects/tikal-ui-components/.storybook",
            "browserTarget": "tikal-ui-components:build",
            "port": 6006,
            "styles": ["src/styles.css"],
            "https": true,
            "sslKey": "/.aspnet/dev-certs/trust/key.key",
            "sslCert": "/.aspnet/dev-certs/trust/cert.crt"
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "projects/tikal-ui-components/.storybook",
            "browserTarget": "tikal-ui-components:build",
            "outputDir": "storybook-static",
            "styles": ["src/styles.css"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/tikal-ui-components/**/*.ts",
              "projects/tikal-ui-components/**/*.html"
            ]
          }
        }
      }
    }
  }
}
